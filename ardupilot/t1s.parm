# HEEWING T1-S Ranger for the t1s_sim JSON physics backend.
# Outputs: aileron (Y-lead to both), V-tail left/right, twin throttles with diff thrust.
SERVO1_FUNCTION 4
SERVO2_FUNCTION 79
SERVO3_FUNCTION 73
SERVO4_FUNCTION 80
SERVO5_FUNCTION 74
SERVO6_FUNCTION 0
SERVO7_FUNCTION 0
SERVO8_FUNCTION 0
SERVO1_REVERSED 0
SERVO2_REVERSED 0
SERVO4_REVERSED 0
RUDD_DT_GAIN 10
MIXING_GAIN 0.5

# RC from the sim (AETR, ch7 arm switch, ch8 flight mode)
RCMAP_ROLL 1
RCMAP_PITCH 2
RCMAP_THROTTLE 3
RCMAP_YAW 4
RC7_OPTION 153
FLTMODE_CH 8
FLTMODE1 0
FLTMODE2 5
FLTMODE3 7
FLTMODE4 10
FLTMODE5 11
FLTMODE6 12

# Airframe
ARSPD_FBW_MIN 11
ARSPD_FBW_MAX 22
AIRSPEED_CRUISE 15
TRIM_THROTTLE 50
THR_MAX 100
ROLL_LIMIT_DEG 50
PTCH_LIM_MAX_DEG 25
PTCH_LIM_MIN_DEG -25
TECS_CLMB_MAX 4
TECS_SINK_MAX 4

# Hand launch in AUTO (TAKEOFF waypoint) / TAKEOFF mode
TKOFF_THR_MINACC 15
TKOFF_THR_DELAY 2
TKOFF_THR_MINSPD 4
TKOFF_ALT 30

# Sim provides airspeed directly; no RC failsafe needed when RC comes from JSON.
ARSPD_TYPE 100
THR_FAILSAFE 0
