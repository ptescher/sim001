# HEEWING T1-S Ranger for the sim001 JSON physics backend.
# Outputs: aileron (Y-lead to both), V-tail left/right, twin throttles with diff thrust.
SERVO1_FUNCTION 4
SERVO2_FUNCTION 79
SERVO3_FUNCTION 73
SERVO4_FUNCTION 80
SERVO5_FUNCTION 74
SERVO6_FUNCTION 0
SERVO7_FUNCTION 0
SERVO8_FUNCTION 0
SERVO1_REVERSED 0
SERVO2_REVERSED 0
SERVO4_REVERSED 0
RUDD_DT_GAIN 10
MIXING_GAIN 0.5

# RC from the sim (AETR, ch7 arm switch, ch8 flight mode)
RCMAP_ROLL 1
RCMAP_PITCH 2
RCMAP_THROTTLE 3
RCMAP_YAW 4
RC5_OPTION 153
FLTMODE_CH 8
FLTMODE1 0
FLTMODE2 5
FLTMODE3 7
FLTMODE4 10
FLTMODE5 11
FLTMODE6 12

# Airframe
# (AIRSPEED_MIN/MAX replaced ARSPD_FBW_MIN/MAX in ArduPilot 4.5; the old names are ignored.)
AIRSPEED_MIN 11
AIRSPEED_MAX 22
AIRSPEED_CRUISE 15
# Note: in AUTO, holding the throttle stick above half raises the target airspeed toward
# AIRSPEED_MAX (THROTTLE_NUDGE). Set THROTTLE_NUDGE 0 to have AUTO ignore the stick.
TRIM_THROTTLE 50
THR_MAX 100
ROLL_LIMIT_DEG 50
PTCH_LIM_MAX_DEG 25
PTCH_LIM_MIN_DEG -25
TECS_CLMB_MAX 4
TECS_SINK_MAX 4

# Hand launch in AUTO (TAKEOFF waypoint) / TAKEOFF mode
TKOFF_THR_MINACC 15
TKOFF_THR_DELAY 2
TKOFF_THR_MINSPD 4
TKOFF_ALT 30

# Sim provides airspeed directly; no RC failsafe needed when RC comes from JSON.
ARSPD_TYPE 100
THR_FAILSAFE 0

# 4S 1800 mAh pack (the sim's). Low: RTL; critical: land (RTL without a landing sequence).
BATT_CAPACITY 1800
BATT_LOW_VOLT 13.6
BATT_LOW_MAH 450
BATT_CRT_VOLT 13.2
BATT_CRT_MAH 180
BATT_FS_LOW_ACT 1
BATT_FS_CRT_ACT 2

# RTL: climb straight ahead to 30 m before turning for home, so an RTL from low altitude
# (e.g. AUTO with no mission right after a hand launch) doesn't circle into trees.
RTL_CLIMB_MIN 30
