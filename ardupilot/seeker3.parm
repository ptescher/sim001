# DeepSpace Seeker 3 (sim001 --aircraft seeker3), layered over t1s.parm: a 3 inch quadcopter, flown
# as a quadplane with a quad frame and no wing. Motor 1 front right, 2 rear left, 3 front left, 4
# rear right (ArduPilot's quad X) on SERVO1 to SERVO4. In the Towers game the server's radio flies
# it in QLOITER with the sticks, so there is no forward flight and no AGENT mode.
# 2 is QuadPlane with the VTOL AUTO: a mission flies its waypoints as a multicopter does. With 1 the
# plane flies them as a plane (it banks to turn and waits for an airspeed that a wingless quad never
# has), and the quad drifts away with the wind.
Q_ENABLE 2
Q_FRAME_CLASS 1
Q_FRAME_TYPE 1
SERVO1_FUNCTION 33
SERVO2_FUNCTION 34
SERVO3_FUNCTION 35
SERVO4_FUNCTION 36
SERVO5_FUNCTION 0
SERVO1_REVERSED 0
SERVO2_REVERSED 0
SERVO3_REVERSED 0
SERVO4_REVERSED 0

# The radio's mode channel (channel 8), from the lowest PWM to the highest. The same list is in
# the aircraft description (rc_modes): QHOVER, QLOITER, GUIDED, AUTO, QRTL and QLAND.
FLTMODE1 18
FLTMODE2 19
FLTMODE3 15
FLTMODE4 10
FLTMODE5 21
FLTMODE6 20
RC5_OPTION 153
RC7_OPTION 0

Q_M_PWM_MIN 1000
Q_M_PWM_MAX 2000
Q_M_THST_EXPO 1.0
Q_M_THST_HOVER 0.30
Q_M_HOVER_LEARN 2
Q_M_SPIN_ARM 0.05
Q_M_SPIN_MIN 0.10

# No wing: the rotors always fly it. ArduPlane will not arm a quadplane with Q_ASSIST_SPEED 0
# ("Q_ASSIST_SPEED is not set"), so it is 1 m/s: assist only ever helps in a forward flight mode,
# and this one flies in GUIDED (QGUIDED) and the Q modes.
Q_ASSIST_SPEED 1
Q_GUIDED_MODE 1

# How fast it flies. A Seeker 3 flown in acro tops 40 m/s (about 150 km/h); the sim's level top
# speed is 32 m/s at 39 degrees of lean. QuadPlane's defaults are for a big VTOL in a hover
# (15 degrees, 5 m/s, gentle braking), which made the light drone the slowest in Towers: the radio
# (`towers_server`'s `hover_sticks`) flies it in QLOITER, whose full stick is Q_LOIT_SPEED_MS. These
# are in degrees and m/s (the ArduPilot we build moved them from centi-units: Q_ANGLE_MAX, Q_VELZ_MAX,
# Q_WP_SPEED, Q_WP_ACCEL and Q_P_POSXY_P are gone, and Q_PILOT_SPD_UP 300 was 300 m/s).
Q_A_ANGLE_MAX 45
Q_LOIT_ANG_MAX 40
Q_LOIT_SPEED_MS 25
Q_LOIT_ACC_MAX_M 6
Q_LOIT_BRK_ACC_M 5
Q_LOIT_BRK_JRK_M 10
Q_LOIT_BRK_DELAY 0.3
Q_P_NE_JERK 10
Q_WP_SPD 25
Q_WP_ACC 5
Q_PILOT_SPD_UP 5
Q_PILOT_SPD_DN 3
Q_PILOT_ACCEL_Z 5
# A 3 inch quad rolls far quicker than a VTOL: QuadPlane's 75 deg/s and 400 deg/s/s would take a
# second to lean it over.
Q_A_RATE_R_MAX 360
Q_A_RATE_P_MAX 360
Q_A_ACC_R_MAX 1500
Q_A_ACC_P_MAX 1500

# A 4S pack, 2500 mAh so that a game's 8 minutes in the air do not drain it (a real 850 mAh one
# would). The failsafes are off, as on the VTOL (a hard climb sags the pack, and
# with the capacity ones on a drone that flew a game could not arm again after a crash).
BATT_CAPACITY 2500
BATT_LOW_MAH 0
BATT_CRT_MAH 0
BATT_LOW_VOLT 0
BATT_CRT_VOLT 0

# A 280 g quad has far more thrust for its inertia than a quadplane's defaults expect, so the
# default rate gains oscillate: a third of them, with a lower filter on the derivative.
Q_A_RAT_RLL_P 0.045
Q_A_RAT_RLL_I 0.045
Q_A_RAT_RLL_D 0.0012
Q_A_RAT_PIT_P 0.045
Q_A_RAT_PIT_I 0.045
Q_A_RAT_PIT_D 0.0012
Q_A_RAT_YAW_P 0.12
Q_A_RAT_YAW_I 0.012
