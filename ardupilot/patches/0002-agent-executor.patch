+MAV_RESULT ModeAgent::handle_command(const mavlink_command_int_t &packet, Refusal &why)
+{
+    switch (packet.command) {
+    case CMD_PLAN:
+        return handle_plan(packet, why);
+    case CMD_GAME:
+        return handle_game(packet, why);
+    case CMD_STANDING:
+        return handle_standing(packet, why);
+    default:
+        return MAV_RESULT_UNSUPPORTED;
+    }
+}
+
+MAV_RESULT ModeAgent::handle_plan(const mavlink_command_int_t &packet, Refusal &why)
+{
+    if (!AP_AGENT_EXEC) {
+        why = Refusal::NO_EXECUTOR;
+        return MAV_RESULT_UNSUPPORTED;
+    }
+    if (plane.control_mode != this) {
+        why = Refusal::NOT_IN_AGENT;
+        return MAV_RESULT_DENIED;
+    }
+    // WirePlan::from_command, and a little stricter: a z that no plan packs to, and a point
+    // off the globe, are refused too
+    uint16_t primitive, target, id;
+    if (!finite_u16(packet.param1, primitive) || primitive > 6 ||
+        !finite_u16(packet.param2, target) ||
+        !finite_u16(packet.param3, id) ||
+        !isfinite(packet.param4) ||
+        !isfinite(packet.z) || packet.z < 0 || packet.z >= 4194304.0f ||
+        packet.x < -900000000 || packet.x > 900000000 ||
+        packet.y < -1800000000 || packet.y > 1800000000) {
+        why = Refusal::MALFORMED;
+        return MAV_RESULT_DENIED;
+    }
+    Location home;
+    if (!home_origin(home)) {
+        why = Refusal::NO_HOME;
+        return MAV_RESULT_TEMPORARILY_REJECTED;
+    }
+    // altitude (-512..511.75 m, 0.25 m steps) and radius (0..1023 m) packed in z
+    const uint32_t v = uint32_t(packet.z);
+    const float alt = float((v >> 10) & 0xFFF) / 4.0f - 512.0f;
+    const float radius = float(v & 0x3FF);
+    float north, east;
+    to_local(home, packet.x, packet.y, north, east);
+
+    // WirePlan::to_plan
+    struct agent_plan p {};
+    p.id = id;
+    p.primitive = uint8_t(primitive);
+    p.target = uint8_t(target);
+    p.point[0] = north;
+    p.point[1] = east;
+    p.point[2] = -alt;
+    p.radius = radius;
+    p.band[0] = alt;
+    p.band[1] = alt + radius;
+    p.ttl = MAX(packet.param4, 0.0f);
+    // the executor adopts it on its next step if the id is new, and keeps it
+    plan = p;
+    have_plan = true;
+#if HAL_LOGGING_ENABLED
+    // @LoggerMessage: AGPL
+    // @Description: SIM001 agent: a plan accepted, in the local frame
+    // @Field: TimeUS: Time since system startup
+    // @Field: Id: plan id
+    // @Field: Prim: primitive
+    // @Field: Tgt: target system id
+    // @Field: PN: point, north of home (m)
+    // @Field: PE: point, east of home (m)
+    // @Field: PD: point, down (m)
+    // @Field: Rad: radius (m)
+    // @Field: BLo: band, lowest (m above home)
+    // @Field: BHi: band, highest (m above home)
+    // @Field: TTL: seconds it is good for
+    AP::logger().Write("AGPL", "TimeUS,Id,Prim,Tgt,PN,PE,PD,Rad,BLo,BHi,TTL", "QHBBfffffff",
+                       AP_HAL::micros64(), p.id, p.primitive, p.target, p.point[0], p.point[1], p.point[2],
+                       p.radius, p.band[0], p.band[1], p.ttl);
+#endif
+    return MAV_RESULT_ACCEPTED;
+}
+
+MAV_RESULT ModeAgent::handle_standing(const mavlink_command_int_t &packet, Refusal &why)
+{
+    // The fields of a plan, but param4 is the seconds without a new plan after which it is flown.
+    // handle_plan checks them and fills `plan`: take the result and put the plan back.
+    const struct agent_plan kept = plan;
+    const bool had = have_plan;
+    const MAV_RESULT result = handle_plan(packet, why);
+    if (result == MAV_RESULT_ACCEPTED) {
+        standing = plan;
+        have_standing = true;
+    }
+    plan = kept;
+    have_plan = had;
+    return result;
+}
+
+MAV_RESULT ModeAgent::handle_game(const mavlink_command_int_t &packet, Refusal &why)
+{
+    // WireGame::from_command
+    uint16_t role, no_tag_back;
+    if (!finite_u16(packet.param1, role) || role > 2 ||
+        !isfinite(packet.param2) ||
+        !finite_u16(packet.param3, no_tag_back)) {
+        why = Refusal::MALFORMED;
+        return MAV_RESULT_DENIED;
+    }
+    game.role = uint8_t(role);
+    game.time_left = packet.param2;
+    game.no_tag_back = uint8_t(no_tag_back);
+    game.received_ms = AP_HAL::millis();
+#if HAL_LOGGING_ENABLED
+    // @LoggerMessage: AGME
+    // @Description: SIM001 agent: the state of the game, as the ground sent it
+    // @Field: TimeUS: Time since system startup
+    // @Field: Role: 0 free, 1 it, 2 runner
+    // @Field: Left: seconds left in the game
+    // @Field: NTB: system id that can't be tagged back
+    AP::logger().Write("AGME", "TimeUS,Role,Left,NTB", "QBfB",
+                       AP_HAL::micros64(), game.role, game.time_left, game.no_tag_back);
+#endif
+    return MAV_RESULT_ACCEPTED;
+}
+
+void ModeAgent::handle_adsb_vehicle(const mavlink_adsb_vehicle_t &packet)
+{
+    const uint32_t need = ADSB_FLAGS_VALID_COORDS | ADSB_FLAGS_VALID_ALTITUDE;
+    if ((packet.flags & need) != need) {
+        return;
+    }
+    const uint8_t id = packet.ICAO_address & 0xFF;
+    if (id == gcs().sysid_this_mav()) {
+        // ourselves, echoed back by the ground
+        return;
+    }
+    Location home;
+    if (!home_origin(home)) {
+        return;
+    }
+    const uint32_t now = AP_HAL::millis();
+    // the same aircraft, else a free slot, else the one heard longest ago
+    TrackEntry *slot = nullptr;
+    for (auto &t : track_table) {
+        if (t.used && t.id == id) {
+            slot = &t;
+            break;
+        }
+    }
+    if (slot == nullptr) {
+        for (auto &t : track_table) {
+            if (!t.used || now - t.heard_ms > TRACK_TIMEOUT_MS) {
+                slot = &t;
+                break;
+            }
+        }
+    }
+    if (slot == nullptr) {
+        slot = &track_table[0];
+        for (auto &t : track_table) {
+            if (t.heard_ms < slot->heard_ms) {
+                slot = &t;
+            }
+        }
+    }
+    float north, east;
+    to_local(home, packet.lat, packet.lon, north, east);
+    // ADSB_VEHICLE altitude is above sea level (mm), whatever altitude_type says
+    // (home.alt is above sea level, cm; differences in integers, as above)
+    const float down = -float(int64_t(packet.altitude) - int64_t(home.alt) * 10) * 0.001f;
+    float vn = 0, ve = 0, vd = 0;
+    const uint32_t vel_ok = ADSB_FLAGS_VALID_HEADING | ADSB_FLAGS_VALID_VELOCITY;
+    if ((packet.flags & vel_ok) == vel_ok) {
+        const float hv = packet.hor_velocity * 0.01f;
+        const float hdg = radians(packet.heading * 0.01f);
+        vn = hv * cosf(hdg);
+        ve = hv * sinf(hdg);
+    }
+    if (packet.flags & ADSB_FLAGS_VERTICAL_VELOCITY_VALID) {
+        vd = -packet.ver_velocity * 0.01f;   // ver_velocity is up positive
+    }
+    slot->id = id;
+    slot->used = true;
+    slot->heard_ms = now;
+    slot->tslc = packet.tslc;
+    slot->pos[0] = north;
+    slot->pos[1] = east;
+    slot->pos[2] = down;
+    slot->vel[0] = vn;
+    slot->vel[1] = ve;
+    slot->vel[2] = vd;
+    memset(slot->callsign, 0, sizeof(slot->callsign));
+    memcpy(slot->callsign, packet.callsign, MIN(sizeof(slot->callsign) - 1, sizeof(packet.callsign)));
+#if HAL_LOGGING_ENABLED
+    // @LoggerMessage: AGTK
+    // @Description: SIM001 agent: a track heard (ADSB_VEHICLE), in the local frame
+    // @Field: TimeUS: Time since system startup
+    // @Field: Id: track id (low byte of ICAO_address)
+    // @Field: PN: north of home (m)
+    // @Field: PE: east of home (m)
+    // @Field: PD: down (m)
+    // @Field: VN: velocity north (m/s)
+    // @Field: VE: velocity east (m/s)
+    // @Field: VD: velocity down (m/s)
+    // @Field: Tslc: the sender's time since last contact (s)
+    AP::logger().Write("AGTK", "TimeUS,Id,PN,PE,PD,VN,VE,VD,Tslc", "QBffffffB",
+                       AP_HAL::micros64(), id, north, east, down, vn, ve, vd, packet.tslc);
+#endif
+}
+
+void ModeAgent::fill_tracks(uint32_t now_ms)
+{
+    for (uint8_t i = 0; i < AGENT_MAX_TRACKS; i++) {
+        const TrackEntry &e = track_table[i];
+        agent_track &t = tracks[i];
+        t = {};
+        if (!e.used) {
+            continue;
+        }
+        const uint32_t heard = now_ms - e.heard_ms;
+        t.id = e.id;
+        t.age = heard * 0.001f + e.tslc;
+        t.valid = heard < TRACK_TIMEOUT_MS && t.age * 1000 < TRACK_TIMEOUT_MS;
+        for (uint8_t k = 0; k < 3; k++) {
+            t.pos[k] = e.pos[k];
+            t.vel[k] = e.vel[k];
+        }
+    }
+}
+
+void ModeAgent::fill_limits(struct agent_limits &l) const
+{
+    l = {};
+    l.fence_centre[0] = fence_n;
+    l.fence_centre[1] = fence_e;
+    l.fence_radius = MAX(fence_r.get(), 0.0f);
+#if AP_FENCE_ENABLED
+    const AC_Fence *fence = AP::fence();
+    if (!is_positive(l.fence_radius) && fence != nullptr && (fence->get_enabled_fences() & AC_FENCE_TYPE_CIRCLE)) {
+        // the circle geofence, centred on home
+        l.fence_centre[0] = 0;
+        l.fence_centre[1] = 0;
+        l.fence_radius = fence->get_radius_m();
+    }
+#endif
+    l.ceiling = ceiling;
+    l.floor = floor;
+    l.bank_max = radians(plane.aparm.roll_limit);
+    l.pitch_max = radians(plane.aparm.pitch_limit_max);
+    l.pitch_min = radians(plane.aparm.pitch_limit_min);   // negative, as Limits::default has it
+    l.airspeed_min = plane.aparm.airspeed_min + airspeed_margin;
+    l.airspeed_cruise = plane.aparm.airspeed_cruise;
+    l.airspeed_max = plane.aparm.airspeed_max;
+    l.separation = separation;
+    l.grace = grace;
+}
+
+void ModeAgent::fill_state(struct agent_state &s, uint32_t now_ms, float dt)
+{
+    s = {};
+    // what the EKF doesn't have is NaN: the executor's bad-input fallback takes it from there
+    Vector3f pos, vel;
+    if (!ahrs.get_relative_position_NED_home(pos)) {
+        pos = Vector3f(NAN, NAN, NAN);
     }
+    if (!ahrs.get_velocity_NED(vel)) {
+        vel = Vector3f(NAN, NAN, NAN);
+    }
+    s.pos[0] = pos.x;
+    s.pos[1] = pos.y;
+    s.pos[2] = pos.z;
+    s.vel[0] = vel.x;
+    s.vel[1] = vel.y;
+    s.vel[2] = vel.z;
+    s.roll = ahrs.get_roll_rad();
+    s.pitch = ahrs.get_pitch_rad();
+    s.yaw = ahrs.get_yaw_rad();
+    // true airspeed: the sensor, or the AHRS's estimate without one; else the ground speed
+    float tas;
+    if (!ahrs.airspeed_TAS(tas)) {
+        tas = vel.length();
+    }
+    s.airspeed = tas;
+    // height above the ground: height above home. The T1-S flies over a flat field, and
+    // the sim's ground is flat; terrain data or a rangefinder would go here.
+    s.agl = -pos.z;
+    s.dt = dt;
+    s.time = (now_ms - entered_ms) * 0.001f;
+}
+
+static void send_named_int(const char *name, int32_t value)
+{
+    mavlink_named_value_int_t packet {};
+    packet.time_boot_ms = AP_HAL::millis();
+    packet.value = value;
+    memcpy(packet.name, name, MIN(strlen(name), (size_t)MAVLINK_MSG_NAMED_VALUE_INT_FIELD_NAME_LEN));
+    gcs().send_to_active_channels(MAVLINK_MSG_ID_NAMED_VALUE_INT, (const char *)&packet);
+}
+
+void ModeAgent::send_status()
+{
+    // cognition_plan::status_names
+    send_named_int("AG_PLAN", have_plan ? plan.id : 0);
+    send_named_int("AG_PRIM", have_plan ? plan.primitive : 0);
+    send_named_int("AG_FLY", agent_exec_flown());
+    send_named_int("AG_ENV", int32_t(interventions));
+    send_named_int("AG_FALL", last_fallback);
+}
