+// cognition_plan::wire::to_local: a flat earth around home. The differences are taken in
+// integer 1e-7 degrees: a float latitude is only good to about half a metre.
+static void to_local(const Location &home, int32_t lat_e7, int32_t lon_e7, float &north, float &east)
+{
+    const int64_t dlat = int64_t(lat_e7) - home.lat;
+    int64_t dlon = int64_t(lon_e7) - home.lng;
+    if (dlon > 1800000000LL) {
+        dlon -= 3600000000LL;
+    } else if (dlon < -1800000000LL) {
+        dlon += 3600000000LL;
+    }
+    const float m_per_e7 = float(EARTH_R) * radians(1.0e-7f);
+    north = float(dlat) * m_per_e7;
+    east = float(dlon) * m_per_e7 * cosf(radians(home.lat * 1.0e-7f));
+}
+
+// cognition_plan's finite_u16: a finite number in 0..=65535, truncated
+static bool finite_u16(float v, uint16_t &out)
+{
+    if (!isfinite(v) || v < 0 || v > 65535) {
+        return false;
+    }
+    out = uint16_t(v);
+    return true;
+}
