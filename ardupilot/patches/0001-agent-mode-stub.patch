+// SIM001: the agent mode. It sets the attitude and the throttle that the stock
+// controllers then fly, as FBWA does, so what it asks for is always an attitude.
+class ModeAgent : public Mode
+{
+public:
+
+    Number mode_number() const override { return Number::AGENT; }
+    const char *name() const override { return "Agent"; }
+    const char *name4() const override { return "AGNT"; }
+
+    // methods that affect movement of the vehicle in this mode
+    void update() override;
+    void run() override;
+
+protected:
+
+    bool _enter() override;
+};
