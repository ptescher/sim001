diff --git a/ArduPlane/mode_agent.cpp b/ArduPlane/mode_agent.cpp
new file mode 100644
index 0000000..ae0d062
--- /dev/null
+++ b/ArduPlane/mode_agent.cpp
@@ -0,0 +1,58 @@
+#include "mode.h"
+#include "Plane.h"
+
+/*
+  SIM001 agent mode.
+
+  Phase 0 stub: wings level, nose at the level pitch, the pilot's throttle. Later the plan
+  executor sets nav_roll_cd, nav_pitch_cd and the throttle here; the stock stabilisation
+  flies them, so the agent only ever asks for an attitude.
+ */
+
+#ifndef AP_AGENT_EXEC
+#define AP_AGENT_EXEC 0
+#endif
+
+#if AP_AGENT_EXEC
+// cognition_executor, a Rust static library (domains/cognition/executor/include/agent_executor.h)
+extern "C" {
+struct agent_demand { int32_t roll_cd; int32_t pitch_cd; float throttle; };
+uint32_t agent_exec_abi_version(void);
+int32_t agent_exec_step(struct agent_demand *out);
+}
+#endif
+
+bool ModeAgent::_enter()
+{
+#if AP_AGENT_EXEC
+    plane.gcs().send_text(MAV_SEVERITY_INFO, "Agent: executor ABI %u", (unsigned)agent_exec_abi_version());
+#else
+    plane.gcs().send_text(MAV_SEVERITY_INFO, "Agent: stub, wings level");
+#endif
+    return true;
+}
+
+void ModeAgent::update()
+{
+    int32_t roll_cd = 0, pitch_cd = 0;
+#if AP_AGENT_EXEC
+    struct agent_demand d;
+    if (agent_exec_step(&d) == 0) {
+        roll_cd = d.roll_cd;
+        pitch_cd = d.pitch_cd;
+    }
+#endif
+    plane.nav_roll_cd = constrain_int32(roll_cd, -plane.roll_limit_cd, plane.roll_limit_cd);
+    plane.update_load_factor();
+    plane.nav_pitch_cd = pitch_cd;
+    plane.adjust_nav_pitch_throttle();
+    plane.nav_pitch_cd = constrain_int32(plane.nav_pitch_cd, plane.pitch_limit_min*100, plane.aparm.pitch_limit_max.get()*100);
+}
+
+void ModeAgent::run()
+{
+    // Run base class function and then output throttle
+    Mode::run();
+
+    output_pilot_throttle();
+}
