# Rust build output (sim, gcs/ and station/ each have their own target/)
target/

# Per-machine radio / gamepad calibration (written by the F2 wizard)
controls.cfg

# Generated by `t1s_sim --export-map gcs/assets`
gcs/assets/

# ArduPilot SITL run files, when sim_vehicle.py is run from the repo root
eeprom.bin
mav.parm
mav.tlog
mav.tlog.raw
/logs/
/terrain/

# macOS and editors
.DS_Store
.vscode/
.idea/
*.swp
*~

# Claude Code per-user settings (shared project settings in .claude/ stay tracked)
.claude/settings.local.json

# Map packs built by tools/mapbuild (downloaded data; map.txt configs are tracked)
maps/*/build/

# The manual: generated by `--expect --docs docs` (results and screenshots) and
# `expectation docs` (pages and site). The hand-made pictures in docs/*.png stay tracked.
/docs/README.md
/docs/features/
/docs/glossary.md
/docs/results/
/docs/screenshots/
/docs/site/
/docs/tests.md
/docs/tests/
/docs/tutorials/
/docs/vocabulary.md
