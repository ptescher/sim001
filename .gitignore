# Rust build output (one target/ at the root for the whole workspace)
target/

# Per-machine radio / gamepad calibration (written by the F2 wizard)
controls.cfg

# Generated by `sim001 --export-map domains/teleoperation/console/assets`
domains/teleoperation/console/assets/
# Generated by `towers_view --export-map domains/teleoperation/command/assets` (the commander app does it)
domains/teleoperation/command/assets/

# ArduPilot SITL run files, when sim_vehicle.py is run from the repo root
eeprom.bin
mav.parm
mav.tlog
mav.tlog.raw
/logs/
/terrain/

# macOS and editors
.DS_Store
.vscode/
.idea/
*.swp
*~

# Claude Code per-user settings (shared project settings in .claude/ stay tracked)
.claude/settings.local.json

# Map packs built by domains/visualization/mapbuild (downloaded data; map.txt configs are tracked)
maps/*/build/

# The manual: generated by `--expect --docs docs` (results and screenshots) and
# `expectation docs` (pages and site). The hand-made pictures in docs/*.png stay tracked.
/docs/README.md
/docs/features/
/docs/glossary.md
/docs/manual/
/docs/results/
/docs/screenshots/
/docs/site/
/docs/platforms/
/docs/tests.md
/docs/tests/
/docs/tutorials/
/docs/vocabulary.md

# ArduPilot SITL, built natively by ardupilot/build_native.sh
/.ardupilot/
/.ardupilot-venv/
.ardupilot-agent/
/league/
